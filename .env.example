# Copy to data/.env (outside git). Never commit the real file.
PORT=3580
# Gemini keys for OCR, comma separated (free-tier keys from different Gmail accounts)
GEMINI_API_KEYS=
# Pages read in parallel; about the number of working Gemini keys
OCR_CONCURRENCY=2
# Admin login email and first password (after an email-OTP reset the new password is stored hashed in the database).
# ADMIN_PASSWORD is also the x-admin-key that local scripts (scripts/sec-feed.js) send to /api/upload.
ADMIN_EMAIL=shivlalbainslaofficial@gmail.com
ADMIN_PASSWORD=
# Brevo (transactional email) for the password-reset code
BREVO_API_KEY=
MAIL_FROM=intubemediaofficial@gmail.com   # must be a verified Brevo sender
